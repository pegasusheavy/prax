                <td class="py-3 px-4"><span class="text-success-400">✅</span>*</td>
              </tr>
              <tr class="border-b border-border">
                <td class="py-3 px-4">nextval/currval</td>
                <td class="py-3 px-4"><span class="text-success-400">✅</span></td>
                <td class="py-3 px-4"><span class="text-muted">❌</span></td>
                <td class="py-3 px-4"><span class="text-muted">❌</span></td>
                <td class="py-3 px-4"><span class="text-success-400">✅</span></td>
